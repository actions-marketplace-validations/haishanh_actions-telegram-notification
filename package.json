{
  "name": "actions-telegram-notification",
  "version": "2.0.0",
  "private": true,
  "license": "MIT",
  "description": "GitHub Action to send Telegram notifications",
  "main": "lib/main.js",
  "prettier": {
    "printWidth": 120,
    "singleQuote": true
  },
  "scripts": {
    "do": "DEBUG=script:* tsx",
    "format": "prettier --write **/*.ts",
    "lint": "eslint src/**/*.ts",
    "prepare": "esbuild src/main.ts --bundle --minify --platform=node --target=node24 --outfile=dist/main.js",
    "local": "NODE_ENV=development tsx --inspect=5858 src/local.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/haishanh/actions-telegram-notification.git"
  },
  "keywords": [
    "actions",
    "node",
    "telegram",
    "notification"
  ],
  "dependencies": {
    "@actions/core": "3.0.1",
    "@actions/github": "9.1.1",
    "axios": "1.18.0",
    "jsonwebtoken": "^9.0.3"
  },
  "devDependencies": {
    "@octokit/webhooks": "14.2.0",
    "@tsconfig/node24": "^24.0.4",
    "@types/jsonwebtoken": "9.0.10",
    "@types/node": "^25.9.3",
    "@typescript-eslint/eslint-plugin": "8.61.1",
    "@typescript-eslint/parser": "8.61.1",
    "dotenv": "17.4.2",
    "esbuild": "0.28.1",
    "eslint": "10.5.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-simple-import-sort": "^13.0.0",
    "js-yaml": "4.2.0",
    "prettier": "3.8.4",
    "tsx": "4.22.4",
    "typescript": "6.0.3"
  }
}
